# 构建产物
/target

# 本机构建目录固定（含 Windows 绝对路径，不能带到 Linux CI 上）
/.cargo/config.toml

# 本地草稿配置与日志
*.log
/tmp

# 本地记忆文件（项目脉络笔记，只在本机保留，不入库）
/memory

# 发布产物与**签名私钥**（dist/keys/release.key 绝不入库）。
# 整目录忽略，不做任何否定放行 —— 万一有人手滑加个 `!dist/...`，
# 私钥就有被提交的风险；随源码走的示例配置请放 `assets/`。
/dist

# 本地联调用的临时二进制/配置/证书（CDN 模拟器、真机探测脚本等）
/_interop

# 归属地查询的磁盘缓存（运行时生成，含真实客户端 IP，不入库）
ipgeo_cache.json

# Python 工具脚本的缓存
__pycache__/
*.pyc

# 编辑器
.idea/
.vscode/
*.swp

# 第三方二进制（Wintun 驱动），由用户自行下载：https://www.wintun.net/
/assets/wintun.dll
# CI 配置已随源码入库在 ci/ 下；.github/workflows/ 放的是逐字节相同的待启用副本。
# 当前 PAT 只有 repo 权限、没有 workflow scope，GitHub 会拒绝推送该目录
# （REST API 写入同样返回 404）。启用步骤见 ci/README.md：
# 给 token 勾上 workflow 后，删掉下面这行、git add .github/workflows/ 再提交即可。
/.github/workflows/

# 本地打包产物（GitHub Release 由 ci/release.yml 或手动上传）
/dist/
